# Train image for every Train component; multi-stage keeps it thin.

# Tag documents intent, digest resolves, and a digest cannot be abbreviated. uv's
# version MUST match [tool.uv] required-version: the builder runs `uv sync --locked`
# against a lock uv wrote, and the lock carries a format revision.
ARG PYTHON_BASE=python:3.12.16-slim@sha256:b18b261e1b4974b4f321451ad5251ded85abb22c2b8b262da527dda1d031ab30
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.13.6@sha256:af22a52f5eafef3d78e551599d405c02df61919d18028f0cea8eda93bc9986d0

# uv reaches the builder only; the runtime stage never sees it.
FROM ${UV_IMAGE} AS uv

# ==================================================================
# Stage 1: Build environment (Alias: builder)
# ==================================================================
FROM ${PYTHON_BASE} AS builder

COPY --from=uv /uv /usr/local/bin/uv

# build-essential for wheels built from source; git because tsbricks is
# git-sourced; ca-certificates for HTTPS. None of these reach the runtime stage.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    git \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app/

COPY pyproject.toml uv.lock README.md ./

# --no-default-groups, NOT --no-dev. --no-dev disables only the dev group
RUN uv sync --locked --no-cache --no-default-groups --group train \
      --no-install-project --no-editable \
 && /app/.venv/bin/python -m ensurepip --upgrade \
 && /app/.venv/bin/python -m pip install --upgrade pip

COPY src ./src

# Non-editable wheel with no deps
RUN uv pip install --no-deps --no-cache .

# ==================================================================
# Stage 2: Runtime definition (Alias: runtime)
# ==================================================================
FROM ${PYTHON_BASE} AS runtime

# lightgbm's bundled lib_lightgbm.so loads libgomp.so.1, and mlforecast imports
# lightgbm at module scope, so without this every mlforecast importer raises
# OSError. The builder has it via build-essential; only /app/.venv crosses stages.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libgomp1 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app/

COPY --from=builder /app/.venv /app/.venv

# Set image's environment so the uv-managed venv is the default Python
ENV VIRTUAL_ENV=/app/.venv
ENV PATH="/app/.venv/bin:$PATH"

# All three MUST be in the runtime stage: only /app/.venv crosses from the builder.
# ARG goes last, since it changes every commit and invalidates every layer after it.
# Its value is the full SHA plus -dirty, because a digest only exists after the push.
COPY config /app/config
ARG GIT_HASH
ENV FCST_GIT_HASH=${GIT_HASH}

# No ENTRYPOINT or CMD: KFP provides the runtime command via base_image use.
