# Train image for every Train component; multi-stage keeps it thin.

# Tag documents intent, digest resolves, and a digest cannot be abbreviated. The Python
# patch MUST equal .python-version, which the builder enforces.
ARG PYTHON_BASE=python:3.12.16-slim@sha256:b18b261e1b4974b4f321451ad5251ded85abb22c2b8b262da527dda1d031ab30

# ==================================================================
# Stage 1: Build environment (Alias: builder)
# ==================================================================
FROM ${PYTHON_BASE} AS builder

# uv reaches the builder only. Its version MUST match [tool.uv] required-version: the
# builder runs `uv sync --locked` against a lock uv wrote, and the lock carries a format
# revision. Pinned inline, because COPY --from expands no ARG.
COPY --from=ghcr.io/astral-sh/uv:0.13.6@sha256:af22a52f5eafef3d78e551599d405c02df61919d18028f0cea8eda93bc9986d0 \
     /uv /usr/local/bin/uv

# git because tsbricks is git-sourced. Every other dependency is a wheel, so nothing
# compiles, and nothing apt installs here reaches the runtime stage.
RUN apt-get update && apt-get install -y --no-install-recommends git \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app/

# .python-version is copied on purpose: with downloads off, a pin that disagrees with
# the base fails `uv sync` with "No interpreter found". Bump the two together.
ENV UV_PYTHON_DOWNLOADS=never
COPY pyproject.toml uv.lock README.md .python-version ./

# --no-default-groups, NOT --no-dev. --no-dev disables only the dev group
RUN uv sync --locked --no-cache --no-default-groups --group train \
      --no-install-project --no-editable

COPY src ./src

# Non-editable wheel with no deps
RUN uv pip install --no-deps --no-cache .

# ==================================================================
# Stage 2: Runtime definition (Alias: runtime)
# ==================================================================
FROM ${PYTHON_BASE} AS runtime

# upgrade applies Debian fixes published since the base digest; Cloud Build's fresh
# worker reruns it every build. lightgbm's lib_lightgbm.so loads libgomp.so.1, and
# mlforecast imports lightgbm at module scope, so every mlforecast importer needs it.
RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends libgomp1 && \
    rm -rf /var/lib/apt/lists/*

# The base ships a global pip that nothing here uses: Train components set
# install_kfp_package=False, so KFP installs nothing at runtime.
RUN python -m pip uninstall -y pip

RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin appuser

WORKDIR /app/

COPY --from=builder /app/.venv /app/.venv

# Set image's environment so the uv-managed venv is the default Python
ENV VIRTUAL_ENV=/app/.venv
ENV PATH="/app/.venv/bin:$PATH"

# All three MUST be in the runtime stage: only /app/.venv crosses from the builder.
# ARG goes late, since it changes every commit and invalidates every layer after it.
# Its value is the full SHA plus -dirty, because a digest only exists after the push.
COPY config /app/config
ARG GIT_HASH
ENV FCST_GIT_HASH=${GIT_HASH}

# Last, so every step above runs as root; /app and the venv stay root-owned, read-only.
USER appuser

# No ENTRYPOINT or CMD: KFP provides the runtime command via base_image use.
