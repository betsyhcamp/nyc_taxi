{

  // Ensure VS Code loads env vars from .env for Python
  "python.envFile": "${workspaceFolder}/.env.publicsettings",

  // Ensure Jupyter kernels also use the same env file
  "jupyter.envFile": "${workspaceFolder}/.env.publicsettings",

  // Tell Pylance where to find src package
  "python.analysis.extraPaths": [
    "src"
  ],

  // Ensure the integrated terminal has src on PYTHONPATH (macOS)
  "terminal.integrated.env.osx": {
    "PYTHONPATH": "${workspaceFolder}/src"
  }

}
