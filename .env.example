# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Service accounts are supplied here rather than in config/environments/<env>.yaml
# pending an infosec determination on whether identifiers may live in source
# control. They are read by the submit scripts, one per slice; nothing in the
# composition path needs them.
#
# No sourcing step: the submit scripts call python-dotenv's load_dotenv(), so
# filling this in is the whole setup. A variable already exported in the
# environment wins over the value here, because load_dotenv() does not
# override by default.

# may have same service account for all three pipelines.
FCST_FEATURE_SERVICE_ACCOUNT=svc<data-ingress-runner>@<project-id>.iam.gserviceaccount.com
FCST_TRAIN_SERVICE_ACCOUNT=svc<train-runner>@<project-id>.iam.gserviceaccount.com
FCST_INFERENCE_SERVICE_ACCOUNT=svc<inference-runner>@<project-id>.iam.gserviceaccount.com
